#!/bin/sh
# P568 · 提交闸门：知行合一的最后一段
#
# ★ 为什么这个检查必须在这里，而不在 npm test：
#   `npm test` 在开发中【经常】跑，而开发中工作区【就该是脏的】。
#   如果"工作区必须干净"进了 npm test，那每次改文件都会红 —— 而一个会误报的
#   判据，最后一定被绕过（P567 的教训：判断力被噪声磨掉）。
#   ⇒ 而"提交"这个动作，恰恰是【行落地】的那一刻。所以在那一刻检查，才对。
#   ★ 这与 P543-M469 同源：正确时机是动作发生的那一刻，不是"想起来的时候"。
#
# ★★ 它检查两件事（都是对账器看不到的）：
#   ① 有未追踪的新文件 ⇒ 它们不在仓库里 ⇒ 对 clone 的人来说不存在
#   ② 已追踪文件有未提交修改 ⇒ 我改了而没落盘到版本库
#
# ★ 而它【不检查】"改动是否已被 git add" —— 因为那属于提交动作本身，
#   由下面这条命令的 --staged 语义处理。

set -e

fail=0

# ① 未追踪
untracked=$(git ls-files --others --exclude-standard)
if [ -n "$untracked" ]; then
  echo "✗ 有未追踪的文件 —— 它们不在仓库里，clone 的人看不到："
  echo "$untracked" | sed 's/^/    /'
  echo "  ⇒ 要么 git add，要么写进 .gitignore（如果它本不该进仓库）"
  fail=1
fi

# ② 已追踪但有未提交修改（工作区 vs 暂存区）
#
# ★ 注意：这里用 --quiet 只问"有没有"，不列内容 —— 因为在 pre-commit 时
#   "有未提交修改"是【正常】的（我刚改完正要提交）。
#   ⇒ 所以本项只在【拒绝提交一个不完整的改动组装】时有意义：
#     如果某个已追踪文件【既没被 add 也没有任何改动】，那是正常的；
#     如果它被改了【而这次提交没包含它】，那说明改动被落下了。
#
#   实现：比较"工作区 vs 索引" —— 若某个文件的工作区版本与索引不同，
#   说明它有改动【没被这次提交包含】。
left_behind=$(git diff --name-only)
if [ -n "$left_behind" ]; then
  echo "✗ 这些文件有改动，但【不在本次提交里】："
  echo "$left_behind" | sed 's/^/    /'
  echo "  ⇒ 要么 git add 它们，要么它们会成为"改了但没提交"的下一次债"
  fail=1
fi

if [ $fail -ne 0 ]; then
  echo ""
  echo "★★ 提交被拦下 —— 而这不是规矩，是【仓库对 clone 它的人是否完整】。"
  echo "   （紧急情况可用 git commit --no-verify 绕过；而绕过的每一次都该有个理由）"
  exit 1
fi

exit 0
